# Environment for the freqtrade platform.
#
# Copy per service and fill in. Nothing in here is read from a file at runtime --
# these are the variables to set in Render's dashboard. The only reason to keep
# a local copy is running the scripts in scripts/.
#
# Never commit a filled-in version of this file.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and the publishable (anon) key are safe in a browser; the service
# role key and the database password are not, and must stay server-side.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable / anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key - bypasses RLS, server only>

# Project Settings -> API -> JWT Secret. Without it the API cannot verify
# access tokens and every authenticated endpoint returns 500.
SUPABASE_JWT_SECRET=<jwt secret>

# Use the SESSION POOLER URI, not the direct connection. db.<ref>.supabase.co
# resolves to IPv6 only and Render cannot reach it; the symptom is a connection
# timeout that looks like a firewall problem.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Exchange credentials (bot service only) ─────────────────────────────────
# The bot is the only service that gets these. Neither the app nor the worker
# needs them, and neither should have them.
#
# Create a key with TRADE and READ rights only. Verification fails a key that
# can withdraw: a trading bot never needs it, so it adds risk and no capability.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__EXCHANGE__PASSWORD=

# ── Bot configuration ───────────────────────────────────────────────────────
BOT_NAME=freqtrade-bot
FREQTRADE__EXCHANGE__NAME=kucoin
FREQTRADE_STRATEGY=TrendPullbackStrategy
FREQTRADE_DB_SCHEMA=ft_main
FREQTRADE_STAKE_CURRENCY=USDT
FREQTRADE_STAKE_AMOUNT=10
FREQTRADE_MAX_OPEN_TRADES=6
DRY_RUN=false

# Your profiles.id, so rows the bot writes are owned by your account.
# Find it after signing in: select id from public.profiles;
PLATFORM_OWNER_ID=

# FreqUI / REST API login. The bot is a private service, so this API is only
# reachable from inside Render's private network.
API_USERNAME=
API_PASSWORD=
JWT_SECRET_KEY=

# ── App service ─────────────────────────────────────────────────────────────
# The bot's address on Render's private network. Not reachable from outside.
FREQTRADE_API_BASE_URL=http://freqtrade-bot:8080
# Empty means same-origin only, which is all the built-in dashboard needs.
CORS_ORIGINS=

# ── Worker ──────────────────────────────────────────────────────────────────
BACKTEST_DATA_DIR=/data/candles
BACKTEST_USER_DIR=/data/user_data
WORKER_POLL_SECONDS=10

# ── Tooling (local only) ────────────────────────────────────────────────────
# Used by scripts/render_audit.py. Read-only; it never modifies anything.
RENDER_API_KEY=
