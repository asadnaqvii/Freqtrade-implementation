# Neuronaq WhatsApp Trading Bot — Environment Variables
# Copy this to .env and fill in your values

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=neuronaq-verify

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Freqtrade REST API
FREQTRADE_API_URL=http://localhost:8080
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=freqtrader

# Macro Intelligence (optional for MVP testing)
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=

# Encryption (generate with: python -c "import os; print(os.urandom(32).hex())")
ENCRYPTION_KEY=

# Server
PORT=8001
DEBUG=true
